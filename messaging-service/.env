# --- Zookeeper Config ---
ZOOKEEPER_VERSION=7.5.0                  # Image version for Zookeeper
ZOOKEEPER_CLIENT_PORT=2181              # Port for Zookeeper client connections
ZOOKEEPER_TICK_TIME=2000                # Internal tick time for Zookeeper in ms

# --- Kafka Config ---
KAFKA_VERSION=7.5.0                     # Image version for Kafka
KAFKA_PORT=9092                         # Kafka broker port
KAFKA_BROKER_ID=1                       # Broker ID for Kafka
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181 # Zookeeper connection string
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
                                        # External listener for Kafka clients
KAFKA_REPLICATION_FACTOR=1             # Replication factor for internal topics

# --- Messaging Service Config ---
GRPC_PORT=50051                         # gRPC port for messaging-service