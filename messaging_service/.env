# --- Kafka Config for Local Messaging Service ---
# List of Kafka brokers for the Messaging Service to connect to when running locally.
# These should match the ports exposed by the Kafka services in docker-compose.yml.
KAFKA_BROKERS=kafka1:9092,kafka2:9093,kafka3:9094

# Enable auto topic creation (usually for development/testing)
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# --- Messaging Service Config ---
# gRPC port for the messaging_service
GRPC_PORT=50051