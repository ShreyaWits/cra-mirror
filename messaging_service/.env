# Server Settings
GRPC_PORT=50054

# Kafka Connection Settings
KAFKA_BROKERS=kafka1:9092,kafka2:9093,kafka3:9094
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka Topic Configuration
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=3
KAFKA_RETENTION_MS=604800000  # 7 days in milliseconds

# Kafka Producer Configuration
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_BYTES=1048576
KAFKA_BATCH_TIMEOUT_MS=500
KAFKA_COMPRESSION_CODEC=snappy
KAFKA_MAX_ATTEMPTS=5
KAFKA_RETRY_BACKOFF_MS=250
KAFKA_READ_TIMEOUT_MS=5000
KAFKA_WRITE_TIMEOUT_MS=5000

# Kafka Consumer Configuration
KAFKA_CONSUMER_MAX_WAIT_MS=5000
KAFKA_CONSUMER_COMMIT_INTERVAL_MS=5000
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
KAFKA_CONSUMER_HEARTBEAT_MS=1000
KAFKA_CONSUMER_MAX_POLL_RECORDS=500
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# Exactly-once Configuration
KAFKA_ISOLATION_LEVEL=read_committed

# Development/Production Mode
# Set to 'development' for local development, 'production' for production deployment
ENV_MODE=development
CONFIG_SERVICE_URL= http://host.docker.internal:5055/config
CONFIG_SERVICE_TOKEN= eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhZG1pbiI6dHJ1ZSwiZXhwIjoxNzQ3MzE3NDI1fQ.vf4v4ZG6Wm6cIhy5l4G5L3MrabOtxNRnj7Bi97KgQl4
ENVIRONMENT= dev
SERVICE_NAME=messaging_service

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
HttpPort=5055