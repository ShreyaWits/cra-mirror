		{
			"name": "Admin-login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var data = pm.response.json()",
							"if (!data) return",
							"if (data[\"token\"]){",
							"    pm.globals.set(\"user_access_token\", data.data[\"access_token\"]);",
							"    pm.globals.set(\"user_refresh_token\", data.data[\"refresh_token\"]);",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
