# Server settings
REST_PORT=8081                          # Port for REST API server
GRPC_PORT=50051                         # Port for gRPC server

# Database settings (Redis)
REDIS_HOST=redis                   # Host IP for Redis (e.g., Docker host IP)
REDIS_PORT=6379                         # Redis port
REDIS_USER=templateuser                # Redis username (if applicable)
REDIS_PASSWORD=your_redis_password     # Redis password
REDIS_URL=redis:6379                   # Redis container URL (used inside Docker network)

# YugabyteDB settings
YUGABYTEDB_HOST=yugabyte            # Host IP for YugabyteDB
YUGABYTEDB_PORT=5435                    # YugabyteDB port (mapped from container's 5433)
YUGABYTEDB_USER=yugabyte                # YugabyteDB username
YUGABYTEDB_PASSWORD=your_db_password   # YugabyteDB password
YUGABYTEDB_NAME=yugabyte               # YugabyteDB database name

# JWT Secret Key
JWT_SECRET=your_super_secure_jwt_key   # Secret key for signing JWT tokens
